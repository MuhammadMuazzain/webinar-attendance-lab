# Zoom Server-to-Server OAuth (Marketplace app on the account that owns the meeting/webinar)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: default meeting/webinar ID shown in the dashboard
ZOOM_DEFAULT_MEETING_ID=

# App
APP_HOST=127.0.0.1
APP_PORT=5080
DATABASE_PATH=data/attendance.db